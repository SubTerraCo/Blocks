{
  "name": "blocks-desktop",
  "version": "26.6.30-b1",
  "blocksVersion": "v26.06.30b1",
  "description": "Blocks - Time Management Desktop App",
  "main": "dist/main/index.js",
  "author": "Blocks Team",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/PoweredUpLabs/Blocks.git"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/prepare-win-build.mjs",
    "build": "tsc && vite build && node scripts/run-electron-builder-dir.mjs",
    "prebuild:win": "node scripts/prepare-win-build.mjs && node ../../scripts/apply-batch-version.mjs",
    "build:win": "tsc && vite build && node scripts/run-electron-builder-win.mjs",
    "postbuild:win": "node scripts/post-win-build.mjs",
    "build:check": "tsc && vite build",
    "build:mac": "tsc && vite build && electron-builder --mac",
    "build:linux": "tsc && vite build && electron-builder --linux",
    "build:all": "tsc && vite build && electron-builder -mwl",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "release": "electron-builder --publish always",
    "build:release": "node ../../scripts/build-release.mjs",
    "build:release:context": "node ../../scripts/read-ci-context.mjs",
    "test:features:roadmap:headed": "node ../../scripts/run-feature-tests.mjs roadmap-headed",
    "test:features:roadmap": "node ../../scripts/run-feature-tests.mjs roadmap",
    "test:features:headed": "node ../../scripts/run-feature-tests.mjs headed"
  },
  "dependencies": {
    "@blocks/core": "workspace:*",
    "@blocks/ui": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "dexie": "^4.4.4",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.511.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "uuid": "^11.1.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vite-plugin-electron": "^1.0.4",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "build": {
    "extends": "electron-builder.yml"
  }
}
