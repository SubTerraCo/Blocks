{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "NODE_ENV": "production"
      },
      "prebuildCommand": "cd ../.. && pnpm install && pnpm build --filter @blocks/core --filter @blocks/ui"
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "ios": {}
    }
  },
  "submit": {
    "production": {}
  }
}

