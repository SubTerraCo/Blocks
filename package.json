{
  "name": "blocks",
  "version": "26.7.17",
  "private": true,
  "description": "Blocks - AI-powered time management app",
  "author": "Blocks Team",
  "license": "MIT",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "pnpm build --filter @blocks/ui && pnpm --filter web exec next dev --port 3004",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "node scripts/run-playwright.mjs",
    "test:e2e": "node scripts/run-playwright.mjs tests/e2e",
    "test:features": "node scripts/run-feature-tests.mjs all",
    "test:build": "node scripts/run-build-tests.mjs",
    "test:features:headed": "node scripts/run-feature-tests.mjs headed",
    "test:features:ui": "node scripts/run-feature-tests.mjs ui",
    "test:features:roadmap": "node scripts/run-feature-tests.mjs roadmap",
    "test:features:roadmap:headed": "node scripts/run-feature-tests.mjs roadmap-headed",
    "test:features:tags": "node scripts/playwright-feature-tags.mjs",
    "build:release": "node scripts/build-release.mjs",
    "build:release:context": "node scripts/read-ci-context.mjs",
    "build:release:validate": "node scripts/validate-build-release.mjs",
    "release:rollover": "node scripts/daily-release-rollover.mjs --stamp",
    "release:next-batch": "node scripts/daily-release-rollover.mjs --next-batch",
    "release:nightly-push": "node scripts/daily-dev-push.mjs",
    "version:batch": "node scripts/apply-batch-version.mjs",
    "verify": "pnpm build --filter @blocks/core --filter @blocks/ui --filter web && pnpm test:features",
    "test:visual": "playwright test tests/visual --config=tests/playwright.config.ts",
    "test:a11y": "playwright test tests/accessibility --config=tests/playwright.config.ts",
    "test:perf": "playwright test tests/performance --config=tests/playwright.config.ts",
    "test:integration": "playwright test tests/integration --config=tests/playwright.config.ts",
    "test:ui": "node scripts/run-playwright.mjs --allow-interactive --ui",
    "test:report": "playwright show-report",
    "test:update-snapshots": "playwright test tests/visual --update-snapshots --config=tests/playwright.config.ts",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.61.0",
    "@types/node": "^22.15.0",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.1.0",
    "typescript-eslint": "^8.61.0",
    "prettier": "^3.8.4",
    "turbo": "^2.9.18",
    "typescript": "^5.9.3"
  }
}
