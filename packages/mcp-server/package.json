{
  "name": "@blocks/mcp-server",
  "version": "26.6.12",
  "description": "MCP server exposing Blocks task and timeline tools for Hermes/Cursor",
  "type": "module",
  "bin": {
    "blocks-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --watch",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@blocks/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "uuid": "^11.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/uuid": "^10.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
